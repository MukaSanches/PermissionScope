<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PermissionScope</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/PermissionScope.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260415005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7175" />
    <ProjectReference Include="../PermissionScope.Windows/PermissionScope.Windows.csproj" />
    <Content Include="Locales/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/PermissionScope.ico" Link="Assets/PermissionScope.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishXamlResources" AfterTargets="Publish">
    <ItemGroup><ScopeXamlResource Include="$(TargetDir)$(AssemblyName).pri;$(TargetDir)App.xbf" /></ItemGroup>
    <Copy SourceFiles="@(ScopeXamlResource)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
